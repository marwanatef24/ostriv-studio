# Default-deny: only source, reviewed documentation and workflows are public.
/*
!/.gitignore
!/LICENSE
!/README.md
!/CHANGELOG.md
!/COMPATIBILITY.md
!/FEATURE-COVERAGE.md
!/TESTING.md
!/CONTRIBUTING.md
!/THIRD-PARTY-NOTICES.md
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/OstrivStudio/
!/OstrivStudio.Core/
!/OstrivStudio.Tests/
/OstrivStudio/*
!/OstrivStudio/*.cs
!/OstrivStudio/*.csproj
!/OstrivStudio/*.xaml
!/OstrivStudio/resources.json
/OstrivStudio.Core/*
!/OstrivStudio.Core/*.cs
!/OstrivStudio.Core/*.csproj
/OstrivStudio.Tests/*
!/OstrivStudio.Tests/*.cs
!/OstrivStudio.Tests/*.csproj
/OstrivStudio.Tests/Experimental*.cs
