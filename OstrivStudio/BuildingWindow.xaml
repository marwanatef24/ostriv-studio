<Window x:Class="OstrivStudio.BuildingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ostriv Studio" Width="1500" Height="900" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#F3F4F0" Foreground="#20312D" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="WorkButton" TargetType="Button">
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#28483F"/><Setter Property="BorderBrush" Value="#CCD9D1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#166C53"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ActionChoice" TargetType="RadioButton">
      <Setter Property="Background" Value="#F7F9F7"/><Setter Property="Foreground" Value="#29463D"/><Setter Property="Cursor" Value="Hand"/><Setter Property="AutomationProperties.HelpText" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Choice" Background="{TemplateBinding Background}" BorderBrush="#D2DED6" BorderThickness="1" CornerRadius="6" Padding="10,8">
          <StackPanel><TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"/><TextBlock Text="{TemplateBinding Tag}" Foreground="#64786E" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="#E5F3EA"/><Setter TargetName="Choice" Property="BorderBrush" Value="#26765B"/><Setter TargetName="Choice" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="#246BFD"/><Setter TargetName="Choice" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Opacity" Value="0.83"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Choice" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PanelCell" TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,3"/><Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEDE3"/><Setter Property="Foreground" Value="#173D30"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- A single command bar keeps profiles, automation and scanning close at hand. -->
    <Border Background="#173D33">
      <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#D9E8DB" CornerRadius="7" Width="34" Height="34"><TextBlock Text="O" FontSize="20" FontWeight="Bold" Foreground="#285847" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="11,0,0,0"><TextBlock Text="Ostriv Studio" FontSize="18" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="ReleaseLabel" Text="Resource editor" Foreground="#B5CFC0" FontSize="10"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ProfilesButton" Content="Saved rules" Click="Profiles_Click" Style="{StaticResource WorkButton}" Margin="0,0,8,0"/>
          <Button Content="Start saved rules" Click="MonitorRules_Click" Style="{StaticResource WorkButton}" Background="#A8D8B7" Foreground="#143C2F" BorderThickness="0" Margin="0,0,8,0"/>
          <Button Content="Resource overview" Click="ResourceLedger_Click" Style="{StaticResource WorkButton}" Margin="0,0,8,0"/>
          <Button x:Name="ChooseButton" Content="Choose game" Click="ChooseGame_Click" Style="{StaticResource WorkButton}"/>
          <Menu Background="Transparent" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"><MenuItem Header="More" Foreground="White"><MenuItem Header="Review saved rules" Click="PreviewRules_Click"/><MenuItem Header="Supported features" Click="Capabilities_Click"/><Separator/><MenuItem Header="Check for updates" Click="CheckUpdates_Click"/></MenuItem></Menu>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#EAF1E9" BorderBrush="#D2DED3" BorderThickness="0,0,0,1" Padding="20,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ConnectionTitle" Text="Start your settlement" FontWeight="SemiBold" Foreground="#255440" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="ConnectionDetail" Text="Open Ostriv and load a save, then find buildings." Foreground="#5C7365" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" x:Name="ConnectionBadge" Text="Experimental" Foreground="#687C6E" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="16,14,16,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="425"/><ColumnDefinition Width="12"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
      <!-- Building browser -->
      <Border Background="White" BorderBrush="#D8E1D9" BorderThickness="1" CornerRadius="8">
        <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Buildings" FontWeight="SemiBold" FontSize="20"/>
            <TextBlock Text="Find and select buildings to edit" Foreground="#6B7C71" FontSize="11" Margin="0,3,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid><TextBox x:Name="BuildingSearch" TextChanged="BuildingSearch_Changed" Padding="9,7"/><TextBlock x:Name="BuildingSearchHint" Text="Search buildings or stock" Foreground="#85968B" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
              <Button x:Name="ScanButton" Grid.Column="1" Content="Find" ToolTip="Find buildings in the running game" Click="Scan_Click" Style="{StaticResource WorkButton}" Background="#226D53" Foreground="White" BorderThickness="0" Margin="7,0,0,0"/>
              <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel_Click" Style="{StaticResource WorkButton}" Margin="7,0,0,0" Visibility="Collapsed"/>
            </Grid>
            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="BuildingCategory" SelectedIndex="0" SelectionChanged="BuildingCategory_Changed" Padding="6,4"><ComboBoxItem Content="All buildings"/><ComboBoxItem Content="Storage"/><ComboBoxItem Content="Farm"/><ComboBoxItem Content="Trade"/><ComboBoxItem Content="Water"/><ComboBoxItem Content="Other buildings"/></ComboBox>
              <CheckBox Grid.Column="1" x:Name="FilterBuildingsByResource" Content="Match item" ToolTip="Only show buildings containing the resource search" Checked="BuildingResourceFilter_Changed" Unchecked="BuildingResourceFilter_Changed" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#566C5D"/>
            </Grid>
            <TextBlock x:Name="BuildingCount" Text="Load a settlement, then select Find" Foreground="#6B7C71" FontSize="11" Margin="0,9,0,0"/>
            <DockPanel Margin="0,10,0,8"><TextBlock x:Name="SelectionSummary" Text="No buildings selected" Foreground="#54695B" FontSize="11" VerticalAlignment="Center"/><WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
              <Button Content="All" ToolTip="Select all shown buildings" Click="SelectShown_Click" Style="{StaticResource WorkButton}" Padding="8,5" Margin="0,0,5,0"/>
              <Button x:Name="SelectSameTypeButton" Content="Same type" ToolTip="Select shown buildings of the same type" Click="SelectSameType_Click" Style="{StaticResource WorkButton}" Padding="8,5" Margin="0,0,5,0" IsEnabled="False"/>
              <Button Content="Clear" Click="ClearSelection_Click" Style="{StaticResource WorkButton}" Padding="8,5"/>
            </WrapPanel></DockPanel>
          </StackPanel>
          <DataGrid Grid.Row="1" x:Name="BuildingGrid" CellStyle="{StaticResource PanelCell}" Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F7F9F6" HeadersVisibility="None" AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="Building_Changed" RowHeight="64" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns><DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="#718276" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" x:Name="ScanFooter" Text="Ctrl or Shift selects several buildings." Foreground="#718276" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <!-- Resource table and editing controls stay visible together. -->
      <Border Grid.Column="2" Background="White" BorderBrush="#D8E1D9" BorderThickness="1" CornerRadius="8">
        <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock x:Name="SelectedTitle" Text="Choose a building" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="SelectedSubtitle" Text="Its stock and available controls will appear here." Foreground="#6B7C71" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,17,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Resources" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Enter an amount, then choose an action. Grey actions are not yet supported." TextWrapping="Wrap" FontSize="11" Foreground="#718276" Margin="0,3,0,0"/></StackPanel>
            <Grid Grid.Column="1"><TextBox x:Name="ResourceSearch" TextChanged="ResourceSearch_Changed" Padding="9,7"/><TextBlock x:Name="ResourceSearchHint" Text="Search resources" Foreground="#85968B" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
          </Grid>
          <Border Grid.Row="2" x:Name="StockMixPanel" Visibility="Collapsed" Background="#F3F7F3" CornerRadius="6" Padding="10" Margin="0,0,0,9">
            <StackPanel><TextBlock x:Name="StockMixTitle" Text="Stock mix · selected building" FontWeight="SemiBold" FontSize="11" Foreground="#54695B"/>
              <ItemsControl x:Name="StockMixItems" Margin="0,6,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#40584A"/><ProgressBar Value="{Binding Percent}" Maximum="100" Height="5" Margin="0,4,0,0" Foreground="#3B8061" Background="#DDE8DE" ToolTip="Share of observed stored stock"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <DataGrid Grid.Row="3" x:Name="LiveResourceGrid" CellStyle="{StaticResource PanelCell}" Background="White" Foreground="#20312D" RowBackground="White" AlternatingRowBackground="#F7F9F6" BorderThickness="0" GridLinesVisibility="None" RowHeight="50" CanUserAddRows="False" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="ResourceSelection_Changed" HorizontalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EFF4EF"/><Setter Property="Foreground" Value="#607769"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Resource" Binding="{Binding Name}" Width="*" MinWidth="115"/>
              <DataGridTextColumn Header="Stored" Binding="{Binding Stored}" Width="65"/>
              <DataGridTextColumn Header="Reserved" Binding="{Binding Reserved}" Width="75"/>
              <DataGridTextColumn Header="Awaited" Binding="{Binding Awaited}" Width="70"/>
              <DataGridTemplateColumn Header="Amount" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Padding="6,5" VerticalContentAlignment="Center" AutomationProperties.Name="Amount" ToolTip="Enter a quantity for this resource"/>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Actions" Width="210"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Add" Tag="add" Click="ResourceRowAction_Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource WorkButton}" Padding="7,5" Margin="0,0,4,0" ToolTip="Add this amount once to each selected building" ToolTipService.ShowOnDisabled="True"/>
                  <Button Content="Raise" Tag="raise" Click="ResourceRowAction_Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource WorkButton}" Padding="7,5" Margin="0,0,4,0" ToolTip="Increase each selected building to at least this amount once; higher quantities stay unchanged" ToolTipService.ShowOnDisabled="True"/>
                  <Button Content="Keep" Tag="keep" Click="ResourceRowAction_Click" IsEnabled="{Binding CanKeep}" Style="{StaticResource WorkButton}" Padding="7,5" Background="#E5F3EA" ToolTip="Save a minimum rule for every matching building of this type" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="4" Visibility="Collapsed" Background="#F3F7F3" BorderBrush="#DDE8DE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Edit selected resource" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="ActionResource" Text="Select a resource above" Foreground="#688071" FontSize="11" VerticalAlignment="Center"/></Grid>
            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <RadioButton x:Name="AddIntent" GroupName="ResourceAction" Content="Add once" Tag="Add this amount" Style="{StaticResource ActionChoice}" IsChecked="True" Checked="ActionIntent_Changed" Margin="0,0,4,0"/>
              <RadioButton Grid.Column="1" x:Name="RaiseIntent" GroupName="ResourceAction" Content="Raise to" Tag="Increase to this amount" Style="{StaticResource ActionChoice}" Checked="ActionIntent_Changed" Margin="4,0"/>
              <RadioButton Grid.Column="2" x:Name="HoldIntent" GroupName="ResourceAction" Content="Keep stocked" Tag="Save a minimum rule" Style="{StaticResource ActionChoice}" Checked="ActionIntent_Changed" Margin="4,0,0,0"/>
            </Grid>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock x:Name="AmountLabel" Text="Amount to add to each selected building" FontWeight="SemiBold" FontSize="11"/><TextBox x:Name="ActionAmount" AutomationProperties.Name="Quantity" Padding="9,7" Margin="0,5,0,0" TextChanged="ActionAmount_Changed"/><TextBlock x:Name="ActionHint" Text="Choose a building and resource." Foreground="#607669" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
              <Button Grid.Column="1" x:Name="ReviewActionButton" Content="Review addition…" Click="ReviewAction_Click" Style="{StaticResource WorkButton}" Background="#226D53" Foreground="White" BorderThickness="0" IsEnabled="False" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel></Border>
        </Grid>
      </Border>
      <!-- Related building tools are one click away without leaving the workspace. -->
      <Border Grid.Column="4" Background="White" BorderBrush="#D8E1D9" BorderThickness="1" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14">
          <TextBlock Text="Building tools" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Available actions for your selection" Foreground="#718276" FontSize="11" Margin="0,3,0,12"/>
          <Border Background="#F4F7F3" CornerRadius="6" Padding="10" Margin="0,0,0,9"><StackPanel><TextBlock Text="Storage capacity" FontWeight="SemiBold"/><TextBlock x:Name="BuildingToolsSummary" Text="Select supported storage buildings." Foreground="#718276" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,7"/><Button x:Name="CapacityTool" Content="Review capacity…" Click="CapacityEdit_Click" Style="{StaticResource WorkButton}" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Background="#F4F7F3" CornerRadius="6" Padding="10" Margin="0,0,0,9"><StackPanel><TextBlock Text="Farms" FontWeight="SemiBold"/><TextBlock x:Name="FarmSelectionSummary" Text="Select one grain farm." Foreground="#718276" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,7"/><Button x:Name="FarmTool" Content="Open farm planner…" Click="FarmRotation_Click" Style="{StaticResource WorkButton}" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Background="#F4F7F3" CornerRadius="6" Padding="10" Margin="0,0,0,9"><StackPanel><TextBlock Text="Trading" FontWeight="SemiBold"/><TextBlock x:Name="TradeSelectionSummary" Text="Select trading buildings to manage targets." Foreground="#718276" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,7"/><WrapPanel><Button Content="City deals…" Click="TradeDeals_Click" Style="{StaticResource WorkButton}" Padding="9,6" Margin="0,0,6,5"/><Button x:Name="ExportTool" Content="Export targets…" Click="TradingLimits_Click" Style="{StaticResource WorkButton}" Padding="9,6" Margin="0,0,0,5"/></WrapPanel></StackPanel></Border>
          <Border Background="#F4F7F3" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="Markets" FontWeight="SemiBold"/><TextBlock x:Name="MarketSelectionSummary" Text="Select rowhouse shops to see available goods." Foreground="#718276" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,7"/><WrapPanel><Button Content="Assigned goods…" Click="RetailAssignments_Click" Style="{StaticResource WorkButton}" Padding="9,6" Margin="0,0,6,5"/><Button Content="Find shops" Click="FindMarkets_Click" Style="{StaticResource WorkButton}" Padding="9,6" Margin="0,0,0,5"/></WrapPanel><Button Content="Set up shop rules…" Click="SetupMarketRules_Click" Style="{StaticResource WorkButton}" Padding="9,6" HorizontalAlignment="Left" Margin="0,3,0,0"/><TextBlock Text="Quick select" Foreground="#718276" FontSize="11" Margin="0,10,0,5"/><WrapPanel><Button Content="Buckwheat" Tag="Buckwheat" Click="MarketResource_Click" Style="{StaticResource WorkButton}" Padding="7,5" Margin="0,0,5,5"/><Button Content="Clothes" Tag="Clothes" Click="MarketResource_Click" Style="{StaticResource WorkButton}" Padding="7,5" Margin="0,0,5,5"/><Button Content="Shoes" Tag="Shoes" Click="MarketResource_Click" Style="{StaticResource WorkButton}" Padding="7,5" Margin="0,0,5,5"/><Button Content="Warm clothes" Tag="Warm Clothes" Click="MarketResource_Click" Style="{StaticResource WorkButton}" Padding="7,5" Margin="0,0,5,5"/></WrapPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="#E8EEE8" Padding="20,7"><TextBlock x:Name="BottomStatus" Text="Your saved rules stay on this PC." Foreground="#607568" FontSize="11" TextWrapping="Wrap"/></Border>
  </Grid>
</Window>
