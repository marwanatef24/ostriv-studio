<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OstrivStudio</AssemblyName>
    <StartupObject>OstrivStudio.App</StartupObject>
    <Version>0.3.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <ProjectReference Include="..\OstrivStudio.Core\OstrivStudio.Core.csproj" />
    <Content Include="resources.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>
