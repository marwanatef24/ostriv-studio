<Window x:Class="OstrivStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OstrivStudio" Title="Automation profiles · Ostriv Studio" Width="1380" Height="820" MinWidth="1080" MinHeight="680" Background="#142833" Foreground="#F0EEE6" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#1D3D49" BorderBrush="#55706D" BorderThickness="0,0,1,0">
      <Grid Margin="25,28,22,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Width="48" Height="48" HorizontalAlignment="Left" Background="#DBB574" CornerRadius="24"><TextBlock Text="O" FontFamily="Georgia" FontSize="30" Foreground="#1D3D49" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="Ostriv Studio" FontFamily="Georgia" FontSize="23" Margin="0,16,0,3"/>
          <TextBlock Text="Settlement workbench" Foreground="#B4C8C4" FontSize="12"/>
          <Border Background="#355C65" CornerRadius="5" Padding="13,12" Margin="0,38,0,0"><StackPanel><TextBlock Text="Automation profiles" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Your saved resource rules" Foreground="#BFD1CB" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
          <Button Content="Monitor &amp; run rules" Click="MonitorRules_Click" Background="#DFBC7D" Foreground="#192F39" BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Center" Padding="10,13" Margin="0,16,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2"><Border Height="1" Background="#55706D" Margin="0,0,0,16"/><TextBlock Text="Your rules stay on this PC." Foreground="#E5D0A8" FontWeight="SemiBold"/><TextBlock Text="Review a live scan, then start supported rules while you play." TextWrapping="Wrap" Foreground="#B4C8C4" FontSize="11" LineHeight="17" Margin="0,8,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="34,28,34,25">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Your settlement" Foreground="#B5CEC7" FontSize="13"/><TextBlock Text="Saved stock rules" FontSize="33" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock Text="Each building keeps its own minimum. Across buildings shares one combined minimum." Foreground="#B6C8C4" FontSize="13"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Import original rules…" Click="ImportOriginal_Click" ToolTip="Read rules from the original editor's .userpref file"/><Button Content="Choose game" Click="ChooseGame_Click"/><Button x:Name="InspectButton" Content="Check game" Click="Inspect_Click" Background="#DFBC7D" Foreground="#192F39" FontWeight="SemiBold" BorderThickness="0"/></StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="#27444E" BorderBrush="#53716E" BorderThickness="1" CornerRadius="5" Padding="17,13" Margin="0,23,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel>
          <TextBlock x:Name="GameHeading" Text="Game not checked" Foreground="#F0D4A3" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock x:Name="GameDetail" Text="Choose your Ostriv executable or check the detected installation." Foreground="#DAE3DE" TextWrapping="Wrap" Margin="0,4,20,0"/>
          <TextBlock x:Name="GamePathText" Foreground="#B1C3BC" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,20,0"/>
        </StackPanel><TextBlock Grid.Column="1" x:Name="GameBadge" Text="Read only" Foreground="#F0D4A3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,22,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid><TextBox x:Name="SearchBox" ToolTip="Search resource name or category" TextChanged="Search_Changed"/><TextBlock Text="Search resources" Foreground="#A9BCB5" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" x:Name="SearchHint"/></Grid>
          <CheckBox Grid.Column="1" x:Name="ConfiguredOnly" Content="Configured only" Foreground="#D1DED7" VerticalAlignment="Center" Margin="12,0,0,0" Checked="ConfiguredOnly_Changed" Unchecked="ConfiguredOnly_Changed"/>
          <TextBlock Grid.Column="2" x:Name="ResourceCount" Foreground="#B3C8C0" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/></Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Interval (sec)" Foreground="#B9CCC6" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="IntervalBox" Width="58" ToolTip="Time to wait after each completed monitoring or automation scan" TextChanged="Interval_Changed"/><TextBlock Text="Profile" Foreground="#B9CCC6" FontSize="11" VerticalAlignment="Center" Margin="14,0,8,0"/><ComboBox x:Name="ProfileBox" Width="150" SelectionChanged="Profile_Changed"/><Button Content="New" Click="NewProfile_Click" Margin="8,0,0,0"/><Button Content="Save now" Click="Save_Click" Margin="8,0,0,0" Background="#DFBC7D" Foreground="#192F39" FontWeight="SemiBold" BorderThickness="0"/></StackPanel>
      </Grid>
      <Border Grid.Row="3" Background="#203741" CornerRadius="5" BorderBrush="#49635F" BorderThickness="1" ClipToBounds="True">
        <DataGrid x:Name="ResourceGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended" EnableRowVirtualization="True" HorizontalGridLinesBrush="Transparent" VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="0.8*"/>
            <DataGridTextColumn Header="Resource" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="1.3*"/>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="0.5*"/>
            <DataGridTextColumn Header="Target" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
            <DataGridTemplateColumn Header="Building type" Width="2.4*">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BuildingDisplay}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox IsEditable="True" ItemsSource="{x:Static local:ResourceRow.BuildingTypes}" Text="{Binding BuildingType, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Mode" Width="1*">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ModeDisplay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{x:Static local:ResourceRow.Modes}" SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Buildings" Binding="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Settings are saved locally; continuous automation is not running." Foreground="#B7C9C1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <WrapPanel Grid.Column="1">
          <Button Content="Add rule" Click="AddRule_Click" Margin="8,0,0,0"/>
          <Button Content="Remove" Click="RemoveRule_Click" Margin="8,0,0,0"/>
          <Button Content="Set target" Click="BulkTargets_Click" Margin="8,0,0,0"/>
          <Button Content="Enable" Tag="on" Click="ToggleSelected_Click" Margin="8,0,0,0"/>
          <Button Content="Disable" Tag="off" Click="ToggleSelected_Click" Margin="8,0,0,0"/>
          <Button Content="Capacity rules…" Click="CapacityRules_Click" Margin="8,0,0,0"/>
        </WrapPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
