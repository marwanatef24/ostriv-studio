<Window x:Class="OstrivStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OstrivStudio" Title="Saved rules · Ostriv Studio" Width="1400" Height="850" MinWidth="1080" MinHeight="720" Background="#F2F5F9" Foreground="#17253A" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Saved rules" FontSize="32" FontWeight="SemiBold" />
        <TextBlock Text="Set the minimums you want your settlement to keep." Foreground="#56667D" Margin="0,7,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Import original rules…" Click="ImportOriginal_Click" />
        <Button Content="View rule status" Click="MonitorRules_Click" Background="#174F47" Foreground="White" />
        <Button Content="Back to buildings" IsCancel="True" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="245" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="9" BorderBrush="#D5DFEB" BorderThickness="1" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="Profile settings" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="Profile" Foreground="#56667D" Margin="0,22,0,7" />
          <ComboBox x:Name="ProfileBox" SelectionChanged="Profile_Changed" />
          <WrapPanel Margin="0,12,0,0">
            <Button Content="New profile" Click="NewProfile_Click" />
            <Button Content="Save now" Click="Save_Click" Background="#246BFD" Foreground="White" />
          </WrapPanel>
          <TextBlock Text="Check interval, in seconds" Foreground="#56667D" Margin="0,24,0,7" />
          <TextBox x:Name="IntervalBox" TextChanged="Interval_Changed" />
          <Border Height="1" Background="#D8E1EE" Margin="0,24,0,24" />
          <TextBlock Text="Each building" Foreground="#8B4D12" FontWeight="SemiBold" />
          <TextBlock Text="Every matching building keeps its own minimum." Foreground="#56667D" TextWrapping="Wrap" Margin="0,7,0,20" />
          <TextBlock Text="Across buildings" Foreground="#176554" FontWeight="SemiBold" />
          <TextBlock Text="Matching buildings share one combined minimum." Foreground="#56667D" TextWrapping="Wrap" Margin="0,7,0,20" />
          <Button Content="Capacity rules…" Click="CapacityRules_Click" />
          <TextBlock Text="Rules are saved locally and run when automation is on." Foreground="#56667D" TextWrapping="Wrap" Margin="0,24,0,0" />
        </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Margin="0,0,14,0">
            <TextBox x:Name="SearchBox" ToolTip="Search resource, category, ID or building" TextChanged="Search_Changed" />
            <TextBlock x:Name="SearchHint" Text="Search rules, resources or buildings" Foreground="#75859A" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
          <CheckBox Grid.Column="1" x:Name="ConfiguredOnly" Content="Configured only" VerticalAlignment="Center" Checked="ConfiguredOnly_Changed" Unchecked="ConfiguredOnly_Changed" />
          <TextBlock Grid.Column="2" x:Name="ResourceCount" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#56667D" />
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
          <Button Content="Add rule" Click="AddRule_Click" />
          <Button Content="Set minimum" Click="BulkTargets_Click" />
          <Button Content="Enable" Tag="on" Click="ToggleSelected_Click" />
          <Button Content="Disable" Tag="off" Click="ToggleSelected_Click" />
          <Button Content="Remove selected" Click="RemoveRule_Click" />
        </WrapPanel>
        <DataGrid Grid.Row="2" x:Name="ResourceGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended" EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="0.8*" />
            <DataGridTextColumn Header="Resource" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
            <DataGridTextColumn Header="Minimum" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
            <DataGridTemplateColumn Header="Building type" Width="2.4*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding BuildingDisplay}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox IsEditable="True" ItemsSource="{x:Static local:ResourceRow.BuildingTypes}" Text="{Binding BuildingType, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Scope" Width="1.5*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="5" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#8B5C22" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Mode}" Value="Across">
                            <Setter Property="Background" Value="#176554" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ModeDisplay}" Foreground="#FFFFFF" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{x:Static local:ResourceRow.Modes}" SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Building limit" Binding="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <TextBlock x:Name="StatusText" Text="Rules are saved on this PC." Foreground="#56667D" />
      <Expander Header="Game compatibility" Margin="0,12,0,0">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="GameHeading" Text="Game not checked" FontWeight="SemiBold" />
            <TextBlock x:Name="GameDetail" TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock x:Name="GamePathText" FontSize="11" Foreground="#56667D" Margin="0,5,0,0" />
            <TextBlock x:Name="GameBadge" FontSize="11" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Choose game" Click="ChooseGame_Click" />
            <Button x:Name="InspectButton" Content="Check game" Click="Inspect_Click" />
          </StackPanel>
        </Grid>
      </Expander>
    </StackPanel>
  </Grid>
</Window>
