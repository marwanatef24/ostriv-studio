<Application x:Class="OstrivStudio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="BuildingWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#17253A" />
    <SolidColorBrush x:Key="Muted" Color="#56667D" />
    <SolidColorBrush x:Key="Accent" Color="#246BFD" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="#246BFD" />
      <Setter Property="BorderBrush" Value="#CFD8E5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="15,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#8B4D12" />
                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Content" Value="Close"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17253A"/><Setter Property="BorderThickness" Value="1"/></Trigger>
        <Trigger Property="Content" Value="Cancel"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17253A"/><Setter Property="BorderThickness" Value="1"/></Trigger>
        <Trigger Property="Content" Value="Later"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17253A"/><Setter Property="BorderThickness" Value="1"/></Trigger>
        <Trigger Property="Content" Value="Back to buildings"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17253A"/><Setter Property="BorderThickness" Value="1"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#17253A" />
      <Setter Property="BorderBrush" Value="#CFD8E5" />
      <Setter Property="CaretBrush" Value="#246BFD" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Foreground" Value="#1A2921" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#17253A" />
      <Setter Property="RowBackground" Value="#FFFFFF" />
      <Setter Property="AlternatingRowBackground" Value="#F4F7FB" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="RowHeight" Value="48" />
      <Setter Property="ColumnHeaderHeight" Value="38" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#EAF0F7" />
      <Setter Property="Foreground" Value="#536580" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Application.Resources>
</Application>
