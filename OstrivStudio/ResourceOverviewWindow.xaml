<Window x:Class="OstrivStudio.ResourceOverviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Resource ledger · Ostriv Studio" Width="1280" Height="820" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F2F5F9" Foreground="#17253A" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="LedgerGrid" TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="RowBackground" Value="#FFFFFF"/><Setter Property="AlternatingRowBackground" Value="#F4F7FB"/><Setter Property="Foreground" Value="#17253A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="42"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="EnableRowVirtualization" Value="True"/>
    </Style>
    <Style x:Key="LedgerHeader" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#17253A"/><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="LedgerCell" TargetType="DataGridCell"><Setter Property="Padding" Value="12,4"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="LedgerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="14,9"/></Style>
  </Window.Resources>
  <Grid Margin="28,24,28,23"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Settlement resources" Foreground="#56667D" FontSize="12"/><TextBlock Text="Resource ledger" FontFamily="Segoe UI" FontSize="32" Margin="0,3,0,2"/><TextBlock x:Name="SnapshotText" Text="Your latest scan" Foreground="#56667D" FontSize="12"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="RefreshButton" Content="Refresh now" Click="Refresh_Click" Style="{StaticResource LedgerButton}" Margin="0,0,8,0"/><Button x:Name="MonitorButton" Content="Start monitoring" Click="Monitor_Click" Style="{StaticResource LedgerButton}" Margin="0,0,8,0"/><Button Content="Clear history" Click="ClearHistory_Click" Style="{StaticResource LedgerButton}" Margin="0,0,8,0"/><Button Content="Back to buildings" Click="Close_Click" Style="{StaticResource LedgerButton}"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="7" Padding="14,11" Margin="0,18,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ScopeNote" TextWrapping="Wrap" Foreground="#56667D" FontSize="12"/><TextBlock x:Name="ScopeCount" Grid.Column="1" Foreground="#56667D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" MinWidth="370"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.5*" MinWidth="400"/></Grid.ColumnDefinitions>
      <Border Background="#FFFFFF" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="19,17,19,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Resources" FontFamily="Segoe UI" FontSize="22"/><TextBlock x:Name="ResourceCount" Text="" Foreground="#56667D" FontSize="11" Margin="0,3,0,0"/></StackPanel><ComboBox x:Name="ScopeBox" Grid.Column="1" Width="165" VerticalAlignment="Center" SelectionChanged="Scope_Changed" ToolTip="Choose which scanned building candidates to include"><ComboBoxItem Content="Storage buildings"/><ComboBoxItem Content="All candidates"/></ComboBox></Grid>
        <Grid Grid.Row="1" Margin="19,0,19,14"><TextBox x:Name="SearchBox" ToolTip="Search resource name or ID" TextChanged="Search_Changed" Background="#FFFFFF" Foreground="#56667D" BorderBrush="#D5DFEB" CaretBrush="#F2C17F" Padding="10,9"/><TextBlock x:Name="SearchHint" Text="Search resources" Foreground="#56667D" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
        <DataGrid x:Name="ResourceGrid" Grid.Row="2" Style="{StaticResource LedgerGrid}" ColumnHeaderStyle="{StaticResource LedgerHeader}" CellStyle="{StaticResource LedgerCell}" SelectionChanged="Resource_Changed"><DataGrid.Columns>
          <DataGridTextColumn Header="Resource" Binding="{Binding Name}" Width="2.2*"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width=".65*"/><DataGridTextColumn Header="Stored" Binding="{Binding Stored, StringFormat={}{0:N2}}" Width="1.1*"/><DataGridTextColumn Header="Buildings" Binding="{Binding Candidates}" Width=".9*"/>
        </DataGrid.Columns></DataGrid>
        <Grid Grid.Row="3" Margin="19,8,19,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Select a resource to see where it appears." Foreground="#56667D" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="ExportButton" Grid.Column="1" Content="Export shown…" Click="Export_Click" Style="{StaticResource LedgerButton}" Margin="10,0,0,0" ToolTip="Save the displayed resources and their building breakdown as CSV"/></Grid>
      </Grid></Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#FFFFFF" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="8" Padding="20,17" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="SelectedName" Text="Select a resource" FontFamily="Segoe UI" FontSize="26"/><TextBlock x:Name="SelectedDetail" Text="Explore amounts and locations from this scan." Foreground="#56667D" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
          <Button x:Name="FindButton" Grid.Column="1" Content="Find in buildings" Click="FindBuildings_Click" Style="{StaticResource LedgerButton}" Background="#FFFFFF" BorderBrush="#D5DFEB" Foreground="#56667D" FontWeight="SemiBold" IsEnabled="False" VerticalAlignment="Top" ToolTip="Show matching candidates across all building types"/>
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Stored" Foreground="#56667D" FontSize="11"/><TextBlock x:Name="StoredText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Reserved" Foreground="#56667D" FontSize="11"/><TextBlock x:Name="ReservedText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Awaited" Foreground="#56667D" FontSize="11"/><TextBlock x:Name="AwaitedText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Text="Other" Foreground="#56667D" FontSize="11"/><TextBlock x:Name="OtherText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
          </Grid>
          <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Stored stock over your scans" Foreground="#56667D" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="HistoryText" Text="Scan again to start a history." Foreground="#56667D" FontSize="11" Margin="0,4,0,0"/></StackPanel><Canvas x:Name="TrendCanvas" Grid.Column="1" Width="170" Height="40" Margin="15,0,0,0" SizeChanged="Trend_SizeChanged"/></Grid>
          <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,13,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Stored by building" Foreground="#56667D" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/><Canvas x:Name="DistributionCanvas" Grid.Column="1" Height="10" VerticalAlignment="Center" SizeChanged="Distribution_SizeChanged"/><TextBlock x:Name="DistributionText" Grid.Row="1" Grid.ColumnSpan="2" Text="Select a resource to see its distribution." Foreground="#56667D" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></Grid>
        </Grid></Border>
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="19,17,19,12"><TextBlock Text="Where it is" FontFamily="Segoe UI" FontSize="21"/><TextBlock x:Name="LocationDetail" Text="Choose a resource to see its matching candidates." Foreground="#56667D" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
          <DataGrid x:Name="LocationGrid" Grid.Row="1" Style="{StaticResource LedgerGrid}" ColumnHeaderStyle="{StaticResource LedgerHeader}" CellStyle="{StaticResource LedgerCell}"><DataGrid.Columns>
            <DataGridTextColumn Header="Building" Binding="{Binding Name}" Width="2.1*"/><DataGridTextColumn Header="Stored" Binding="{Binding Stored, StringFormat={}{0:N2}}" Width="1*"/><DataGridTextColumn Header="Reserved" Binding="{Binding Reserved, StringFormat={}{0:N2}}" Width="1*"/><DataGridTextColumn Header="Awaited" Binding="{Binding Awaited, StringFormat={}{0:N2}}" Width="1*"/><DataGridTextColumn Header="Other" Binding="{Binding Other, StringFormat={}{0:N2}}" Width=".9*"/>
          </DataGrid.Columns></DataGrid>
          <TextBlock Grid.Row="2" Text="Building numbers are temporary and may change on the next scan." Foreground="#56667D" Margin="19,10,19,13" FontSize="11" TextWrapping="Wrap"/>
        </Grid></Border>
      </Grid>
    </Grid>
    <TextBlock x:Name="SamplingStatus" Grid.Row="3" Text="History is temporary and uses real time. Clear it when loading another save in the same game process." Foreground="#56667D" FontSize="11" Margin="0,13,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
